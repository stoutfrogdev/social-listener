#!/bin/bash

# Pre-commit hook for social-listener project
# This hook enforces branch protection, permissions validation, and quality checks

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Running pre-commit checks..."
echo ""

# Get the current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# =============================================================================
# 1. BRANCH PROTECTION
# =============================================================================

echo "🔒 Checking branch protection..."

if [ "$BRANCH" = "main" ]; then
    echo -e "${RED}❌ ERROR: Direct commits to 'main' are not allowed.${NC}"
    echo ""
    echo "Please use a pull request to merge changes to main."
    echo "To switch to develop: git checkout develop"
    exit 1
fi

if [ "$BRANCH" = "staging" ]; then
    echo -e "${RED}❌ ERROR: Direct commits to 'staging' are not allowed.${NC}"
    echo ""
    echo "Changes should flow from 'develop' to 'staging' via PR."
    echo "To switch to develop: git checkout develop"
    exit 1
fi

echo -e "${GREEN}✅ Branch protection passed (on '$BRANCH')${NC}"
echo ""

# =============================================================================
# 2. PERMISSIONS VALIDATION
# =============================================================================

echo "🔐 Validating approved-permissions.md..."

PERMISSIONS_FILE="instructions/approved-permissions.md"

if [ -f "$PERMISSIONS_FILE" ]; then
    # Check if any forbidden items appear in the approved sections
    # These patterns should NEVER appear after "## Pre-Approved Permissions" or "## Session-Added Permissions"

    FORBIDDEN_PATTERNS=(
        "git push origin main"
        "git push origin staging"
        "git push --force"
        "git reset --hard"
        "rm -rf"
        "skip tests"
        "Skip tests"
        "production deployment"
        "Production deployment"
        "disable pre-commit"
        "Disable pre-commit"
    )

    # Extract content after "## Pre-Approved Permissions" heading
    APPROVED_SECTION=$(awk '/^## Pre-Approved Permissions/,/^## Never Approve|^---$/' "$PERMISSIONS_FILE" 2>/dev/null || true)
    SESSION_SECTION=$(awk '/^## Session-Added Permissions/,0' "$PERMISSIONS_FILE" 2>/dev/null || true)
    COMBINED_SECTIONS="$APPROVED_SECTION $SESSION_SECTION"

    VIOLATION_FOUND=false

    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if echo "$COMBINED_SECTIONS" | grep -qi "$pattern"; then
            echo -e "${RED}❌ ERROR: Forbidden permission found in approved sections: '$pattern'${NC}"
            VIOLATION_FOUND=true
        fi
    done

    if [ "$VIOLATION_FOUND" = true ]; then
        echo ""
        echo "The approved-permissions.md file contains items from the 'Never Approve' list."
        echo "Please remove these items before committing."
        exit 1
    fi

    echo -e "${GREEN}✅ Permissions validation passed${NC}"
else
    echo -e "${YELLOW}⚠️  Warning: $PERMISSIONS_FILE not found, skipping validation${NC}"
fi

echo ""

# =============================================================================
# 3. STAGED FILES CHECK
# =============================================================================

echo "📝 Checking staged files..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${YELLOW}⚠️  No files staged for commit${NC}"
    exit 0
fi

echo "Staged files:"
echo "$STAGED_FILES" | sed 's/^/  - /'
echo ""

# =============================================================================
# 4. SECRETS DETECTION
# =============================================================================

echo "🔍 Scanning for secrets..."

# Patterns that might indicate secrets
SECRET_PATTERNS=(
    "password\s*="
    "api_key\s*="
    "apikey\s*="
    "secret\s*="
    "token\s*="
    "AWS_ACCESS_KEY"
    "AWS_SECRET"
    "PRIVATE_KEY"
    "BEGIN RSA PRIVATE KEY"
    "BEGIN OPENSSH PRIVATE KEY"
)

SECRETS_FOUND=false

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        for pattern in "${SECRET_PATTERNS[@]}"; do
            if git show ":$file" 2>/dev/null | grep -iE "$pattern" | grep -v "process.env" | grep -v "example" | grep -v "#" > /dev/null 2>&1; then
                echo -e "${RED}⚠️  Potential secret pattern found in $file: $pattern${NC}"
                SECRETS_FOUND=true
            fi
        done
    fi
done

if [ "$SECRETS_FOUND" = true ]; then
    echo ""
    echo -e "${YELLOW}⚠️  Warning: Potential secrets detected. Please review before committing.${NC}"
    echo "If these are false positives, you can proceed."
    echo ""
fi

if [ "$SECRETS_FOUND" = false ]; then
    echo -e "${GREEN}✅ No obvious secrets detected${NC}"
fi

echo ""

# =============================================================================
# 5. QUALITY CHECKS (if applicable)
# =============================================================================

echo "🧪 Running quality checks..."

# Check if package.json exists and has the necessary scripts
if [ -f "package.json" ]; then
    # Check for lint script
    if grep -q '"lint"' package.json; then
        echo "Running linter..."
        if npm run lint --silent 2>/dev/null; then
            echo -e "${GREEN}✅ Lint passed${NC}"
        else
            echo -e "${RED}❌ Lint failed. Please fix linting errors before committing.${NC}"
            exit 1
        fi
    fi

    # Check for type-check script
    if grep -q '"type-check"' package.json; then
        echo "Running type check..."
        if npm run type-check --silent 2>/dev/null; then
            echo -e "${GREEN}✅ Type check passed${NC}"
        else
            echo -e "${RED}❌ Type check failed. Please fix type errors before committing.${NC}"
            exit 1
        fi
    fi

    # Check for test script
    if grep -q '"test"' package.json; then
        echo "Running tests..."
        if npm run test --silent 2>/dev/null; then
            echo -e "${GREEN}✅ Tests passed${NC}"
        else
            echo -e "${RED}❌ Tests failed. Please fix failing tests before committing.${NC}"
            echo ""
            echo "To skip tests (requires explicit human permission for each commit):"
            echo "  git commit --no-verify"
            exit 1
        fi
    fi
else
    echo -e "${YELLOW}⚠️  No package.json found, skipping npm-based quality checks${NC}"
fi

echo ""

# =============================================================================
# SUMMARY
# =============================================================================

echo "=========================================="
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo "=========================================="
echo ""
