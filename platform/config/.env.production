# Production Environment Configuration
# Non-secret values only - secrets are injected via CI/CD

# Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=social-listener-prod
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# NextAuth
# NEXTAUTH_URL should be set in CI/CD secrets
# NEXTAUTH_SECRET should be set in CI/CD secrets

# App
NODE_ENV=production
